FROM node:24-bookworm-slim AS sdk-builder

WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches patches
COPY packages/agent-sdk/package.json packages/agent-sdk/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/workbench-client/package.json packages/workbench-client/package.json
COPY packages/workbench-react/package.json packages/workbench-react/package.json
COPY agent-packs/repo-analyst/package.json agent-packs/repo-analyst/package.json
COPY agent-packs/baby-polymancer/package.json agent-packs/baby-polymancer/package.json
COPY agent-packs/baby-swordfish/package.json agent-packs/baby-swordfish/package.json
COPY examples/complex-operator/package.json examples/complex-operator/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY packages/agent-sdk packages/agent-sdk
COPY packages/observability packages/observability
RUN pnpm observability:build && pnpm agent-sdk:build

FROM node:24-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV LANGGRAPH_PORT=2024
ENV LANGGRAPH_UPSTREAM_URL=http://127.0.0.1:2024

RUN apt-get update \
  && apt-get install -y --no-install-recommends ripgrep \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches patches
COPY packages/agent-sdk/package.json packages/agent-sdk/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/workbench-client/package.json packages/workbench-client/package.json
COPY packages/workbench-react/package.json packages/workbench-react/package.json
COPY agent-packs/repo-analyst/package.json agent-packs/repo-analyst/package.json
COPY agent-packs/baby-polymancer/package.json agent-packs/baby-polymancer/package.json
COPY agent-packs/baby-swordfish/package.json agent-packs/baby-swordfish/package.json
COPY examples/complex-operator/package.json examples/complex-operator/package.json
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

COPY --chown=node:node . .
COPY --from=sdk-builder --chown=node:node /app/packages/agent-sdk/dist /app/packages/agent-sdk/dist
COPY --from=sdk-builder --chown=node:node /app/packages/observability/dist /app/packages/observability/dist
RUN mkdir -p /app/.langgraph_api && chown node:node /app/.langgraph_api

USER node

EXPOSE 3000
CMD ["pnpm", "start:langgraph-runtime"]
