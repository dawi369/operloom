# Copy to .dev.vars for local Worker development. Never commit real values.
# Local /v1 API: the bearer token below is honored only on loopback with both
# flags set. The principal defaults to operloom-local.
OPERLOOM_LOCAL_API_ENABLED=true
OPERLOOM_ENVIRONMENT=local
OPERLOOM_LOCAL_API_USER_ID=
OPERLOOM_LOCAL_API_TOKEN=replace-with-a-local-token
OPENROUTER_API_KEY=
# Optional: web search for packages that require search.web (https://exa.ai).
EXA_API_KEY=
OPERLOOM_AGENT_CONNECTION_SECRET=replace-with-a-long-random-secret
OPERLOOM_CALLBACK_SIGNING_SECRET=replace-with-a-long-random-secret

# The normal local workbench starts the signed runner service.
OPERLOOM_RUNNER_TRANSPORT=fly
OPERLOOM_RUNNER_URL=http://127.0.0.1:3101/workbench/tool-runners/invocations
OPERLOOM_RUNNER_SIGNING_SECRET=replace-with-a-long-random-secret
OPERLOOM_CALLBACK_URL=http://127.0.0.1:8787/workbench/run-callbacks

# Optional signed operator alert delivery. Configure both or neither.
OPERLOOM_OPERATOR_ALERT_WEBHOOK_URL=
OPERLOOM_OPERATOR_ALERT_SIGNING_SECRET=

ALLOWED_ORIGINS=http://localhost:3000
