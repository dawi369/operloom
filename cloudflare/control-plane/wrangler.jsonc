{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "operloom-local-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-6-luna",
    "OPENROUTER_SITE_URL": "http://localhost:3000",
    "OPENROUTER_APP_NAME": "operloom-local-cloudflare-chat",
    "OPERLOOM_CALLBACK_URL": "http://127.0.0.1:8787/workbench/run-callbacks",
    "SENTRY_ENVIRONMENT": "local",
    "SENTRY_TRACES_SAMPLE_RATE": "0.02",
  },
  "workflows": [
    {
      "binding": "DURABLE_WORKFLOWS",
      "name": "operloom-local-durable",
      "class_name": "OperloomDurableWorkflow",
    },
  ],
  "triggers": {
    "crons": [],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "operloom_local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "operloom-local-artifacts",
      "preview_bucket_name": "operloom-local-artifacts",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ThreadChatAgent",
        "class_name": "ThreadChatAgent",
      },
      {
        "name": "SessionAgent",
        "class_name": "SessionAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ThreadChatAgent", "SessionAgent"],
    },
  ],
}
