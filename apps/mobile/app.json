{
  "expo": {
    "name": "Operloom",
    "slug": "operloom",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "operloom",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dawi369.operloom",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.dawi369.operloom",
      "adaptiveIcon": { "backgroundColor": "#f7f5ef" }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "experiments": { "typedRoutes": true }
  }
}
