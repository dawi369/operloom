# The Worker origin; the app talks to `${EXPO_PUBLIC_CONTROL_PLANE_ORIGIN}/v1/me` only.
EXPO_PUBLIC_CONTROL_PLANE_ORIGIN=http://127.0.0.1:8788
# WorkOS AuthKit public client (PKCE). The Worker must list the client id in
# OPERLOOM_WORKOS_ALLOWED_CLIENT_IDS.
EXPO_PUBLIC_WORKOS_CLIENT_ID=
EXPO_PUBLIC_WORKOS_ISSUER=https://api.workos.com
