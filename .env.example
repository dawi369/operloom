# Backend (LangGraph server)
OPENROUTER_API_KEY=
# Optional override; defaults to openai/gpt-5.2
OPENROUTER_MODEL=
# Optional OpenRouter attribution metadata
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=operloom

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=operloom

# Sentry error monitoring and traces.
# One Sentry project is used for all operloom runtime surfaces; filter by
# runtime.surface in Sentry:
# - vercel-next
# - cloudflare-worker
# - fly-langgraph (future)
SENTRY_ORG=t23
SENTRY_PROJECT=assistant-mk1
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Local telemetry stays off even when a DSN is present unless both relevant
# flags are enabled explicitly. This keeps development and E2E traffic out of
# hosted error, trace, and replay quotas.
SENTRY_ENABLE_LOCAL=false
NEXT_PUBLIC_SENTRY_ENABLE_LOCAL=false
# Production should stay low-noise; opt-in local debugging may raise these.
SENTRY_TRACES_SAMPLE_RATE=0.02
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.02
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Optional. Used by Sentry source map upload during CI/build; keep secret.
SENTRY_AUTH_TOKEN=

# Frontend (Next.js proxy to LangGraph or the Cloudflare LangGraph facade).
# Local default points directly at LangGraph. Hosted dev points at:
# https://<worker-url>/langgraph
LANGGRAPH_API_URL=http://localhost:2024
# Local-development compatibility only: forwarded as `x-api-key` when the
# Cloudflare dev token and signed facade are both absent. Production rejects
# this fallback; hosted deployments must use the signed Cloudflare facade.
LANGCHAIN_API_KEY=
# Graph id. Must match a key under "graphs" in langgraph.json.
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent
# Optional. Bypasses the /api proxy and lets the browser hit LangGraph directly.
# Leave unset to route everything through the Next.js proxy on the current host.
NEXT_PUBLIC_LANGGRAPH_API_URL=

# WorkOS AuthKit. Server-side secrets stay out of NEXT_PUBLIC_*.
# Configure matching redirect/sign-out URLs in the WorkOS dashboard.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# 32+ chars. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Local: http://localhost:3000/auth/callback
# Production: https://assistant-mk1.vercel.app/auth/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Comma-separated list of allowed CORS origins. When unset, no Access-Control-
# Allow-Origin header is sent (same-origin only). Set to "*" to allow all
# origins (not recommended for production).
ALLOWED_ORIGINS=http://localhost:3000

# Cloudflare-owned workbench run path.
CLOUDFLARE_CONTROL_PLANE_URL=http://localhost:8787
# Must match cloudflare/control-plane/.dev.vars for local Vercel -> Worker calls.
CLOUDFLARE_CONTROL_PLANE_DEV_TOKEN=
# Required in hosted deployments. Signs all Vercel -> Worker facade calls.
CLOUDFLARE_CONTROL_PLANE_FACADE_SIGNING_SECRET=
# Optional separate local signer for public pack webhooks. Hosted deployments
# normally omit this and use the general facade signing secret above.
CLOUDFLARE_CONTROL_PLANE_WEBHOOK_FACADE_SIGNING_SECRET=
# Signs backend workflow callbacks into Cloudflare. Falls back to
# CLOUDFLARE_CONTROL_PLANE_FACADE_SIGNING_SECRET only in local/dev when unset.
WORKBENCH_CALLBACK_SIGNING_SECRET=
# The normal local developer command configures the Worker and signed runner from
# cloudflare/control-plane/.dev.vars. This copy is kept in sync by workbench init.
WORKBENCH_RUNNER_SIGNING_SECRET=
WORKBENCH_OPERATOR_ALERT_SIGNING_SECRET=

# Cloudflare production feature gates. All default false; enable retained data,
# then connections, then mutations only after their release evidence passes.
WORKBENCH_RETAINED_DATA_ENABLED=false
WORKBENCH_CONNECTIONS_ENABLED=false
WORKBENCH_MUTATIONS_ENABLED=false
WORKBENCH_PUSH_ENABLED=false
WORKBENCH_CLIENT_ORIGINS=http://localhost:5173
WORKBENCH_MOBILE_CLIENTS_ENABLED=false
WORKBENCH_WORKOS_ALLOWED_CLIENT_IDS=
WORKBENCH_WORKOS_ISSUER=https://api.workos.com
WORKBENCH_WORKOS_JWKS_URL=
# Isolated release-evidence deployments only. Exposes the synthetic
# conformance package/provider; never enable on the customer-serving stack.
WORKBENCH_CONFORMANCE_MODE=false
# Worker-only WorkOS Vault credential. Never expose through NEXT_PUBLIC_*.
# Configure this as a Cloudflare secret, not a checked-in Wrangler var.
WORKOS_VAULT_API_URL=https://api.workos.com
# Worker secret JSON containing platform-owned OAuth provider modules. Endpoint
# hosts must appear in permittedHosts; clientSecret values remain server-side.
# [{"id":"provider","authorizationUrl":"https://...","tokenUrl":"https://...","clientId":"...","clientSecret":"...","permittedHosts":["..."]}]
WORKBENCH_OAUTH_PROVIDERS_JSON=

# Local fallback identity when WorkOS is not configured. Server-side only;
# browsers do not set tenant scope or agent identity directly. Hosted WorkOS
# traffic resolves the active agent from Cloudflare D1 instead.
# Must be set to true for local fallback; ignored in production.
WORKBENCH_ALLOW_LOCAL_DEV_IDENTITY=true
WORKBENCH_DEV_USER_ID=dev-user
WORKBENCH_DEV_WORKSPACE_ID=dev-workspace
WORKBENCH_DEV_AGENT_ID=dev-agent

# Slash Admin access. Use WorkOS user ids/emails in hosted environments.
# For local fallback without WorkOS, add WORKBENCH_DEV_USER_ID to the ids list.
WORKBENCH_ADMIN_USER_IDS=
WORKBENCH_ADMIN_EMAILS=
