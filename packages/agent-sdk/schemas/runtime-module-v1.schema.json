{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assistant-mk1.dev/schemas/runtime-module-v1.schema.json",
  "title": "Operloom Runtime Module v1 metadata",
  "oneOf": [
    { "$ref": "#/$defs/controlPlane" },
    { "$ref": "#/$defs/runner" },
    { "$ref": "#/$defs/web" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["apiVersion", "kind", "packId", "runtimeVersion", "compatiblePackVersions"],
      "properties": {
        "apiVersion": { "const": 1 },
        "packId": { "type": "string", "minLength": 1 },
        "runtimeVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "compatiblePackVersions": { "type": "string", "minLength": 1 }
      }
    },
    "controlPlane": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "kind": { "const": "agent_control_plane_module" },
            "tools": { "type": "array" },
            "workflows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "conformanceInput": { "type": "object" }
                }
              }
            },
            "health": { "type": "array" },
            "evals": { "type": "array" }
          },
          "required": ["tools", "workflows", "health", "evals"]
        }
      ]
    },
    "runner": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "kind": { "const": "agent_runner_module" },
            "tools": { "type": "array" }
          },
          "required": ["tools"]
        }
      ]
    },
    "web": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "kind": { "const": "agent_web_module" },
            "artifactRenderers": { "type": "object" },
            "managedStateRenderers": { "type": "object" }
          },
          "required": ["artifactRenderers", "managedStateRenderers"]
        }
      ]
    }
  }
}
