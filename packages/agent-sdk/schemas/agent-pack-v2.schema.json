{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assistant-mk1.dev/schemas/agent-pack-v2.schema.json",
  "title": "Operloom Agent Pack API v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "id",
    "templateId",
    "name",
    "version",
    "tools",
    "workflows",
    "connections",
    "managedState",
    "triggers",
    "artifactRenderers",
    "healthChecks",
    "evals",
    "compatibility",
    "resourceLimits",
    "prompt"
  ],
  "properties": {
    "apiVersion": { "const": 2 },
    "kind": { "const": "agent_pack" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "templateId": { "type": "string", "pattern": "^pack-" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string" },
    "profile": { "enum": ["default", "analyst", "operator"] },
    "capabilityLevel": { "enum": ["template", "single_agent_app"] },
    "format": { "const": "xml" },
    "folderPath": { "type": "string" },
    "codePath": { "type": "string" },
    "promptPath": { "type": "string" },
    "tools": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "workflows": { "type": "array", "items": { "type": "object" } },
    "ui": { "type": "object" },
    "risk": { "type": "object" },
    "connections": { "type": "array", "items": { "type": "object" } },
    "context": { "type": "array", "items": { "type": "object" } },
    "managedState": { "type": "array", "items": { "type": "object" } },
    "triggers": { "type": "array", "items": { "type": "object" } },
    "artifactRenderers": { "type": "array", "items": { "type": "object" } },
    "healthChecks": { "type": "array", "items": { "type": "object" } },
    "evals": { "type": "array", "items": { "type": "object" } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packApi", "minimumWorkbenchVersion"],
      "properties": {
        "packApi": { "const": 2 },
        "minimumWorkbenchVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "maximumWorkbenchVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "resourceLimits": { "type": "object" },
    "smokeScenarios": { "type": "array", "items": { "type": "object" } },
    "prompt": { "type": "string", "minLength": 1 }
  }
}
