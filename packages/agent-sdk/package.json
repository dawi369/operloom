{
  "name": "@operloom/agent-sdk",
  "version": "1.0.1",
  "description": "Build-time Agent Pack and Runtime Module contracts for Operloom.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./control-plane": {
      "types": "./dist/control-plane.d.ts",
      "default": "./dist/control-plane.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./schemas/agent-pack-v2.json": {
      "default": "./schemas/agent-pack-v2.schema.json"
    },
    "./schemas/runtime-module-v1.json": {
      "default": "./schemas/runtime-module-v1.schema.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm clean && pnpm build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
