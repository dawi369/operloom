{
  "schemaVersion": 2,
  "target": "production",
  "conformanceMode": false,
  "vaultBackend": "workos",
  "mutationDefaultEnabled": false,
  "cloudflare": {
    "workerName": "operloom-control-plane",
    "d1DatabaseName": "operloom",
    "d1DatabaseId": "${OPERLOOM_PRODUCTION_D1_DATABASE_ID}",
    "r2BucketName": "operloom-artifacts",
    "origin": "${OPERLOOM_PRODUCTION_CLOUDFLARE_ORIGIN}"
  },
  "fly": {
    "appName": "operloom-runner",
    "origin": "${OPERLOOM_PRODUCTION_FLY_ORIGIN}"
  },
  "web": {
    "provider": "vercel",
    "projectName": "operloom",
    "organizationId": "${OPERLOOM_PRODUCTION_VERCEL_ORG_ID}",
    "projectId": "${OPERLOOM_PRODUCTION_VERCEL_PROJECT_ID}",
    "origin": "${OPERLOOM_PRODUCTION_WEB_ORIGIN}",
    "framework": "nextjs",
    "nodeVersion": "24.x"
  },
  "workos": {
    "applicationName": "Operloom",
    "applicationId": "${OPERLOOM_PRODUCTION_WORKOS_APPLICATION_ID}",
    "acceptanceWorkspaceId": "${OPERLOOM_PRODUCTION_ACCEPTANCE_WORKSPACE_ID}"
  },
  "secretEnvironmentVariables": {
    "runnerSigning": "OPERLOOM_PRODUCTION_RUNNER_SIGNING_SECRET",
    "callbackSigning": "OPERLOOM_PRODUCTION_CALLBACK_SIGNING_SECRET",
    "agentConnection": "OPERLOOM_PRODUCTION_AGENT_CONNECTION_SECRET",
    "operatorAlertSigning": "OPERLOOM_PRODUCTION_OPERATOR_ALERT_SIGNING_SECRET",
    "workosCookie": "OPERLOOM_PRODUCTION_WORKOS_COOKIE_PASSWORD",
    "vault": "OPERLOOM_PRODUCTION_VAULT_SECRET",
    "openrouter": "OPERLOOM_PRODUCTION_OPENROUTER_API_KEY"
  },
  "observabilityEnvironmentVariables": {
    "sentryDsn": "OPERLOOM_PRODUCTION_SENTRY_DSN",
    "sentryAuthToken": "OPERLOOM_PRODUCTION_SENTRY_AUTH_TOKEN"
  }
}
