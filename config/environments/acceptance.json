{
  "schemaVersion": 2,
  "target": "acceptance",
  "conformanceMode": true,
  "vaultBackend": "workos",
  "mutationDefaultEnabled": false,
  "cloudflare": {
    "workerName": "operloom-acceptance-control-plane",
    "d1DatabaseName": "operloom_acceptance",
    "d1DatabaseId": "${OPERLOOM_ACCEPTANCE_D1_DATABASE_ID}",
    "r2BucketName": "operloom-acceptance-artifacts",
    "origin": "${OPERLOOM_ACCEPTANCE_CLOUDFLARE_ORIGIN}"
  },
  "fly": {
    "appName": "operloom-acceptance-runner",
    "origin": "${OPERLOOM_ACCEPTANCE_FLY_ORIGIN}"
  },
  "web": {
    "provider": "vercel",
    "projectName": "operloom-acceptance",
    "organizationId": "${OPERLOOM_ACCEPTANCE_VERCEL_ORG_ID}",
    "projectId": "${OPERLOOM_ACCEPTANCE_VERCEL_PROJECT_ID}",
    "origin": "${OPERLOOM_ACCEPTANCE_WEB_ORIGIN}",
    "framework": "nextjs",
    "nodeVersion": "24.x"
  },
  "workos": {
    "applicationName": "Operloom Acceptance",
    "applicationId": "${OPERLOOM_ACCEPTANCE_WORKOS_APPLICATION_ID}",
    "acceptanceWorkspaceId": "${OPERLOOM_ACCEPTANCE_WORKSPACE_ID}"
  },
  "secretEnvironmentVariables": {
    "runnerSigning": "OPERLOOM_ACCEPTANCE_RUNNER_SIGNING_SECRET",
    "callbackSigning": "OPERLOOM_ACCEPTANCE_CALLBACK_SIGNING_SECRET",
    "agentConnection": "OPERLOOM_ACCEPTANCE_AGENT_CONNECTION_SECRET",
    "operatorAlertSigning": "OPERLOOM_ACCEPTANCE_OPERATOR_ALERT_SIGNING_SECRET",
    "workosCookie": "OPERLOOM_ACCEPTANCE_WORKOS_COOKIE_PASSWORD",
    "vault": "OPERLOOM_ACCEPTANCE_VAULT_SECRET",
    "openrouter": "OPERLOOM_ACCEPTANCE_OPENROUTER_API_KEY"
  },
  "observabilityEnvironmentVariables": {
    "sentryDsn": "OPERLOOM_ACCEPTANCE_SENTRY_DSN",
    "sentryAuthToken": "OPERLOOM_ACCEPTANCE_SENTRY_AUTH_TOKEN"
  }
}
