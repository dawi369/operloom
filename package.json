{
  "name": "operloom",
  "version": "1.0.0",
  "private": true,
  "description": "Build and run agent systems you own. TypeScript workflows, durable execution, approvals, and an inspectable workspace.",
  "homepage": "https://github.com/dawi369/operloom#readme",
  "bugs": {
    "url": "https://github.com/dawi369/operloom/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawi369/operloom.git"
  },
  "scripts": {
    "dev": "pnpm operloom dev",
    "dev:workbench": "tsx scripts/workbench-dev.ts",
    "dev:frontend": "pnpm agent-sdk:build && tsx scripts/run-with-log.ts output/dev/frontend.log pnpm exec next dev --webpack --disable-source-maps --hostname 127.0.0.1",
    "dev:backend": "langgraphjs dev --host 127.0.0.1 --port 2024 --no-browser",
    "build": "pnpm observability:build && pnpm agent-sdk:build && pnpm workbench-client:build && tsx scripts/run-with-log.ts output/dev/frontend-build.log pnpm exec next build",
    "start": "next start",
    "prepare": "pnpm observability:build && pnpm agent-sdk:build && pnpm workbench-client:build",
    "start:backend": "langgraphjs dev --host 0.0.0.0 --port ${LANGGRAPH_PORT:-2024} --no-browser",
    "start:langgraph-gateway": "tsx scripts/langgraph-runtime-gateway.ts",
    "start:langgraph-runtime": "concurrently -n gateway,langgraph -c cyan,magenta \"pnpm start:langgraph-gateway\" \"pnpm start:backend\"",
    "test:unit": "vitest run",
    "observability:check": "tsx scripts/check-observability.ts && vitest run lib/observability/sentry-scrubber.test.ts",
    "observability:build": "pnpm --filter @operloom/observability build",
    "eval:real-session-posture": "tsx scripts/eval-real-session-posture.ts",
    "conformance:level2": "tsx scripts/run-level2-conformance.ts",
    "conformance:level3": "tsx scripts/run-level3-conformance.ts",
    "conformance:agent-system": "tsx scripts/run-agent-system-conformance.ts",
    "conformance:extension-contract": "tsx scripts/run-extension-contract-conformance.ts",
    "conformance:data-lifecycle": "tsx scripts/run-production-conformance.ts data-lifecycle",
    "conformance:connections": "tsx scripts/run-production-conformance.ts connections",
    "conformance:actions": "tsx scripts/run-production-conformance.ts actions",
    "conformance:client": "tsx scripts/run-client-conformance.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:fix": "oxlint --fix && oxfmt",
    "e2e:seed": "tsx scripts/reset-playwright-state.ts && wrangler d1 execute assistant_mk1_local --local --persist-to output/playwright/state --file cloudflare/control-plane/schema.sql --config cloudflare/control-plane/wrangler.jsonc --yes && wrangler d1 execute assistant_mk1_local --local --persist-to output/playwright/state --file tests/e2e/workbench-seed.sql --config cloudflare/control-plane/wrangler.jsonc --yes && tsx scripts/seed-e2e-complex-operator.ts",
    "e2e:serve:runner": "PORT=3101 WORKBENCH_E2E_MODE=true WORKBENCH_E2E_RUNNER_DELAY_MS=${WORKBENCH_E2E_RUNNER_DELAY_MS:-0} WORKBENCH_RUNNER_SIGNING_SECRET=e2e-runner-signing-secret-00000001 WORKBENCH_CALLBACK_SIGNING_SECRET=e2e-callback-signing-secret-000001 WORKBENCH_CALLBACK_ORIGIN=http://127.0.0.1:8788 WORKBENCH_RUNNER_CALLBACK_URL=http://127.0.0.1:8788 tsx scripts/run-with-log.ts output/playwright/runner.log pnpm start:langgraph-gateway",
    "e2e:serve:worker": "pnpm agent-sdk:build && pnpm e2e:seed && tsx scripts/run-with-log.ts output/playwright/worker.log wrangler dev --config cloudflare/control-plane/wrangler.jsonc --local --persist-to output/playwright/state --port 8788 --var ALLOWED_ORIGINS:http://localhost:3100 --var CLOUDFLARE_CONTROL_PLANE_DEV_TOKEN:e2e-control-plane-token --var CLOUDFLARE_CONTROL_PLANE_FACADE_SIGNING_SECRET:e2e-facade-signing-secret-000001 --var CLOUDFLARE_CONTROL_PLANE_REQUIRE_FACADE_SIGNATURE:false --var WORKBENCH_AGENT_CONNECTION_SECRET:e2e-agent-connection-secret-000001 --var WORKBENCH_CALLBACK_SIGNING_SECRET:e2e-callback-signing-secret-000001 --var WORKBENCH_CALLBACK_URL:http://127.0.0.1:8788/workbench/run-callbacks --var WORKBENCH_RUNNER_TRANSPORT:fly --var WORKBENCH_RUNNER_URL:http://127.0.0.1:3101/workbench/tool-runners/invocations --var WORKBENCH_RUNNER_SIGNING_SECRET:e2e-runner-signing-secret-00000001 --var WORKBENCH_E2E_MODE:true --var WORKBENCH_E2E_EXPORT_PAUSE_MS:600 --var WORKBENCH_RETAINED_DATA_ENABLED:true --var WORKBENCH_CONNECTIONS_ENABLED:true --var WORKBENCH_MUTATIONS_ENABLED:true --var WORKBENCH_VAULT_BACKEND:memory --var 'WORKBENCH_OAUTH_PROVIDERS_JSON:[{\"id\":\"synthetic-broker\",\"authorizationUrl\":\"http://127.0.0.1:3101/e2e/oauth/authorize\",\"tokenUrl\":\"http://127.0.0.1:3101/e2e/oauth/token\",\"actionUrl\":\"http://127.0.0.1:3101/e2e/actions\",\"clientId\":\"e2e-client\",\"permittedHosts\":[\"127.0.0.1\"]}]'",
    "test:e2e:signed-out": "E2E_RELEASE_MODE=signed-out playwright test",
    "test:e2e:local:release": "WORKBENCH_E2E_RUNNER_DELAY_MS=0 E2E_RELEASE_MODE=local-session playwright test tests/e2e/release.spec.ts tests/e2e/workbench-accessibility.spec.ts",
    "release:screenshots": "WORKBENCH_E2E_RUNNER_DELAY_MS=0 E2E_RELEASE_MODE=local-session playwright test tests/e2e/release-screenshots.spec.ts",
    "test:e2e:local": "pnpm test:e2e:local:release && pnpm test:service-boundaries",
    "test:e2e": "pnpm test:e2e:signed-out && pnpm test:e2e:local",
    "test:service-boundaries:level2": "WORKBENCH_E2E_RUNNER_DELAY_MS=1500 E2E_RELEASE_MODE=local-session playwright test tests/e2e/level2-conformance.spec.ts",
    "test:service-boundaries:level3": "WORKBENCH_E2E_RUNNER_DELAY_MS=1500 E2E_RELEASE_MODE=local-session playwright test tests/e2e/level3-conformance.spec.ts",
    "test:service-boundaries:agent-system": "WORKBENCH_E2E_RUNNER_DELAY_MS=0 E2E_RELEASE_MODE=local-session playwright test tests/e2e/agent-system-conformance.spec.ts",
    "test:service-boundaries:data-lifecycle": "WORKBENCH_E2E_RUNNER_DELAY_MS=0 E2E_RELEASE_MODE=local-session playwright test tests/e2e/production-data-lifecycle.spec.ts",
    "test:service-boundaries": "pnpm test:service-boundaries:level2 && pnpm test:service-boundaries:level3",
    "docs:check": "tsx scripts/check-doc-links.ts && tsx scripts/check-release-identity.ts",
    "release:identity:check": "tsx scripts/check-release-identity.ts",
    "workbench": "tsx scripts/workbench-cli.ts",
    "workbench:init": "tsx scripts/workbench-init.ts",
    "workbench:fork": "tsx scripts/workbench-fork.ts",
    "workbench:dev": "tsx scripts/workbench-dev.ts",
    "workbench:doctor": "tsx scripts/workbench-doctor.ts",
    "verify:onboarding": "tsx scripts/verify-onboarding.ts",
    "environment:check": "tsx scripts/check-environment.ts",
    "environment:render": "tsx scripts/render-environment-config.ts",
    "environment:configure-secrets": "tsx scripts/configure-environment-secrets.ts",
    "environment:provision": "tsx scripts/provision-environment.ts",
    "verify:environment-config": "tsx scripts/check-environment.ts --target local --configuration-only && tsx scripts/check-environment.ts --target acceptance --configuration-only && tsx scripts/check-environment.ts --target production --configuration-only && tsx scripts/check-environment.ts --target demo --configuration-only",
    "release:evidence:run": "tsx scripts/run-release-evidence.ts",
    "release:evidence:collect": "tsx scripts/collect-release-evidence.ts",
    "release:evidence:record": "tsx scripts/record-release-evidence.ts",
    "acceptance:hosted:public": "tsx scripts/accept-hosted-public.ts",
    "acceptance:hosted:configuration": "tsx scripts/accept-hosted-configuration.ts",
    "acceptance:hosted:observability": "tsx scripts/accept-hosted-observability.ts",
    "acceptance:hosted:level3:preflight": "tsx scripts/check-hosted-level3-preflight.ts",
    "acceptance:hosted:level3": "tsx scripts/run-hosted-level3-drills.ts",
    "acceptance:hosted:vault": "tsx scripts/accept-hosted-vault.ts",
    "acceptance:hosted:mutation": "tsx scripts/accept-hosted-mutation.ts",
    "acceptance:hosted:data-lifecycle": "tsx scripts/accept-hosted-data-lifecycle.ts",
    "acceptance:hosted:alert-redelivery": "tsx scripts/accept-hosted-alert-redelivery.ts",
    "acceptance:hosted:soak": "tsx scripts/accept-hosted-soak.ts",
    "verify:security": "tsx scripts/verify-security-audit.ts",
    "verify:docker": "tsx scripts/verify-docker-image.ts",
    "verify:runtime-architecture": "vitest run cloudflare/control-plane/src/runtime-architecture.test.ts scripts/agent-pack-compiler.test.ts",
    "verify:fast": "pnpm docs:check && pnpm observability:check && pnpm verify:onboarding && pnpm verify:environment-config && pnpm agent-packs:compile --check && pnpm agent-packs:validate && pnpm agent-sdk:verify && pnpm agent-sdk:contract --check && pnpm workbench-client:verify && pnpm workbench-client:contract --check && pnpm conformance:extension-contract && pnpm verify:runtime-architecture && pnpm db:cloudflare:migrations:verify && pnpm db:cloudflare:backup:verify && pnpm test:unit && pnpm typecheck && pnpm lint",
    "verify": "pnpm verify:fast && pnpm verify:security && pnpm build",
    "release:check": "pnpm verify && pnpm conformance:client && pnpm conformance:data-lifecycle && pnpm conformance:connections && pnpm conformance:actions && pnpm conformance:agent-system && pnpm verify:docker && pnpm conformance:level2 && pnpm conformance:level3",
    "fork:check": "pnpm release:check && pnpm test:e2e",
    "agent-packs:validate": "tsx scripts/agent-packs-validate.ts",
    "agent-packs:inspect": "tsx scripts/agent-packs-inspect.ts",
    "agent-packs:smoke": "tsx scripts/agent-packs-smoke.ts",
    "agent-packs:compile": "tsx scripts/compile-agent-packs.ts",
    "agent-packs:test": "tsx scripts/test-agent-pack.ts",
    "agent-packs:check": "tsx scripts/check-agent-pack.ts",
    "agent-sdk:build": "pnpm --filter @operloom/agent-sdk build",
    "agent-sdk:verify": "pnpm agent-sdk:build && tsx scripts/verify-agent-sdk-consumer.ts",
    "agent-sdk:contract": "pnpm agent-sdk:build && tsx scripts/check-agent-sdk-contract.ts",
    "workbench-client:build": "pnpm --filter @operloom/workbench-client build && pnpm --filter @operloom/workbench-react build",
    "workbench-client:pack": "pnpm workbench-client:build && tsx scripts/pack-workbench-client.ts",
    "workbench-client:verify": "pnpm workbench-client:build && tsx scripts/verify-workbench-client-consumer.ts",
    "workbench-client:contract": "pnpm workbench-client:build && tsx scripts/check-workbench-client-contract.ts",
    "agent-packs:create": "tsx scripts/create-agent-pack.ts",
    "db:cloudflare:rebuild:local": "wrangler d1 execute assistant_mk1_local --local --file cloudflare/control-plane/schema.sql --config cloudflare/control-plane/wrangler.jsonc",
    "db:cloudflare:migrate:local": "wrangler d1 migrations apply assistant_mk1_local --local --config cloudflare/control-plane/wrangler.jsonc",
    "db:cloudflare:migrate": "tsx scripts/environment-command.ts --phase migrate-cloudflare",
    "db:cloudflare:backup": "tsx scripts/backup-environment.ts",
    "db:cloudflare:migrations:verify": "tsx scripts/verify-d1-migrations.ts",
    "db:cloudflare:backup:verify": "tsx scripts/verify-d1-backup-restore.ts",
    "deploy:cloudflare:bootstrap": "tsx scripts/environment-command.ts --phase bootstrap-cloudflare",
    "deploy:cloudflare": "tsx scripts/environment-command.ts --phase deploy-cloudflare",
    "dev:cloudflare": "wrangler dev --config cloudflare/control-plane/wrangler.jsonc --local --port 8787",
    "deploy:fly": "tsx scripts/environment-command.ts --phase deploy-fly",
    "deploy:web": "tsx scripts/environment-command.ts --phase deploy-web",
    "deploy:vercel": "tsx scripts/environment-command.ts --phase deploy-vercel",
    "smoke:langgraph-runtime": "tsx scripts/smoke-langgraph-runtime.ts",
    "smoke:cloudflare-authz": "tsx scripts/smoke-cloudflare-authz.ts",
    "smoke:cloudflare-workspace-context": "tsx scripts/smoke-cloudflare-workspace-context.ts",
    "smoke:cloudflare-workspaces": "tsx scripts/smoke-cloudflare-workspaces.ts",
    "smoke:cloudflare-membership-policy": "tsx scripts/smoke-cloudflare-membership-policy.ts",
    "smoke:cloudflare-agent-selection": "tsx scripts/smoke-cloudflare-agent-selection.ts",
    "smoke:cloudflare-agent-provisioning": "tsx scripts/smoke-cloudflare-agent-provisioning.ts",
    "smoke:cloudflare-agent-behavior": "tsx scripts/smoke-cloudflare-agent-behavior.ts",
    "smoke:cloudflare-agent-runtime-config": "tsx scripts/smoke-cloudflare-agent-runtime-config.ts",
    "smoke:cloudflare-agent-chat": "tsx scripts/smoke-cloudflare-agent-chat.ts",
    "smoke:cloudflare-agent-chat-auth": "tsx scripts/smoke-cloudflare-agent-chat-auth.ts",
    "smoke:cloudflare-signed-facade": "tsx scripts/smoke-cloudflare-signed-facade.ts",
    "smoke:cloudflare-runtime-traces": "tsx scripts/smoke-cloudflare-runtime-traces.ts",
    "smoke:cloudflare-chat-runtime-summary": "tsx scripts/smoke-cloudflare-chat-runtime-summary.ts",
    "smoke:cloudflare-chat-reset": "tsx scripts/smoke-cloudflare-chat-reset.ts",
    "smoke:cloudflare-chat-session": "tsx scripts/smoke-cloudflare-chat-session.ts",
    "smoke:cloudflare-chat-session-lifecycle": "tsx scripts/smoke-cloudflare-chat-session-lifecycle.ts",
    "smoke:cloudflare-session-events": "tsx scripts/smoke-cloudflare-session-events.ts",
    "smoke:cloudflare-chat-threads": "tsx scripts/smoke-cloudflare-chat-threads.ts",
    "smoke:cloudflare-history": "tsx scripts/smoke-cloudflare-history.ts",
    "smoke:polymarket-readonly": "tsx scripts/smoke-polymarket-readonly.ts",
    "smoke:cloudflare-workflow-callback-auth": "tsx scripts/smoke-cloudflare-workflow-callback-auth.ts",
    "smoke:cloudflare-langgraph-facade": "tsx scripts/smoke-cloudflare-langgraph-facade.ts",
    "smoke:cloudflare-chat-boundary": "tsx scripts/smoke-cloudflare-chat-boundary.ts",
    "smoke:cloudflare-session-boundary": "tsx scripts/smoke-cloudflare-session-boundary.ts",
    "smoke:cloudflare-policy-boundary": "tsx scripts/smoke-cloudflare-policy-boundary.ts",
    "smoke:cloudflare-event-feed": "tsx scripts/smoke-cloudflare-event-feed.ts",
    "smoke:cloudflare-event-stream": "tsx scripts/smoke-cloudflare-event-stream.ts",
    "smoke:cloudflare-deploy-readiness": "pnpm smoke:cloudflare-signed-facade && pnpm smoke:cloudflare-workspace-context && pnpm smoke:cloudflare-policy-boundary && pnpm smoke:cloudflare-session-boundary && pnpm smoke:cloudflare-event-stream",
    "smoke:fly-tool-runner": "tsx scripts/smoke-fly-tool-runner.ts",
    "smoke:tenant-isolation": "pnpm smoke:cloudflare-workspace-context",
    "operloom": "tsx scripts/workbench-cli.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.24",
    "@assistant-ui/react-ai-sdk": "^1.3.38",
    "@assistant-ui/react-markdown": "^0.14.1",
    "@cloudflare/ai-chat": "0.8.6",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/langgraph-cli": "^1.4.3",
    "@langchain/langgraph-sdk": "^1.9.6",
    "@langchain/openrouter": "^0.3.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@operloom/agent-sdk": "workspace:*",
    "@operloom/observability": "workspace:*",
    "@operloom/workbench-client": "workspace:*",
    "@operloom/workbench-react": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/cloudflare": "^10.55.0",
    "@sentry/nextjs": "^10.55.0",
    "@sentry/node": "^10.55.0",
    "@workos-inc/authkit-nextjs": "^4.1.1",
    "agents": "0.16.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "croner": "10.0.1",
    "jose": "5.10.0",
    "lucide-react": "^1.16.0",
    "next": "^16.3.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "pnpm": ">=10.33.0 <11"
  },
  "packageManager": "pnpm@10.33.0"
}
